    "Ooh, a cookie covered in tiny stars—I’m going to eat a constellation!" : {
      "comment" : "Recipe book: what the chef says about this dish or ingredient.",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ooh, kue penuh bintang mungil—aku mau makan satu rasi bintang!"
          }
        }
      }
    },
    "Ooh, bubbles—I’ll poke just one before we start cooking… okay, two." : {
      "comment" : "Recipe book: what the chef says about this dish or ingredient.",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ooh, gelembung—aku tusuk satu saja sebelum mulai masak… oke, dua."
          }
        }
      }
    },
    "Ooh, it opened up—hello in there, you smell surprisingly good!" : {
      "comment" : "Recipe book: what the chef says about this dish or ingredient.",
