        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ah!—oh, ternyata tanganku sendiri yang bikin dia melambai."
          }
        }
      }
    },
    "All set! Delivered lots of dishes and stay active!" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semuanya siap! Sajikan banyak hidangan dan tetaplah aktif!"
